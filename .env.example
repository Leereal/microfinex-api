# Environment Variables
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/microfinex_db"

# Supabase - PLEASE UPDATE WITH YOUR ACTUAL CREDENTIALS
SUPABASE_URL="https://your_project_ref.supabase.co"
SUPABASE_ANON_KEY="your_supabase_anon_key_here"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

# JWT
# Both secrets are mandatory in production - the server refuses to start
# without them rather than fall back to a value published in this repository.
# Generate each with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Browsers the API accepts cross-origin requests from, comma separated.
# Defaults to http://localhost:3000. A deployed frontend that is not listed
# here has every request blocked by the browser.
ALLOWED_ORIGINS=http://localhost:3000

# How many reverse proxies sit in front of this process. 1 behind a single
# proxy such as Traefik or nginx, 0 when exposed directly. Left at 0 behind a
# proxy, the rate limiter treats every caller as the same client.
TRUST_PROXY=0

# Background jobs: loan status transitions, arrears, penalties and reminders.
# Off by default. Exactly one instance should have this on.
ENABLE_SCHEDULER=false
SCHEDULER_TIMEZONE=UTC

# Redis
REDIS_URL=redis://localhost:6379

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# File Upload
MAX_FILE_SIZE=5242880  # 5MB
UPLOAD_PATH=./uploads

# MinIO / S3 object storage. Uploads are held in memory and streamed here, so
# these are what persist client photos, logos and loan documents - there is no
# local disk fallback. The defaults point at a local MinIO on localhost:9000.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=microfinex
MINIO_URL_EXPIRY=3600

# Encrypts credentials the assistant stores for connected accounts. Unset,
# the encryption service logs a warning and stays disabled. Changing it makes
# everything already encrypted unreadable.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_SALT=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# API Documentation
API_TITLE="Microfinex API"
API_VERSION="1.0.0"
API_DESCRIPTION="Modern Microfinance Management System API"

# OBSE bank statement analysis
# A platform-wide key, used by any organization that activates OBSE without
# saving its own key in Organization Settings. An organization key wins.
OBSE_API_KEY=
# Where the platform key is sent. Defaults to the QA service.
OBSE_BASE_URL=https://api.qa.obse.co.za
# Extra hosts an organization may set as its base URL (comma separated).
# obse.co.za and its subdomains are always allowed.
OBSE_ALLOWED_HOSTS=

# Client communications (email, BulkSMS SMS, WhatsApp)
# Public address of this API, used in unsubscribe links and the WhatsApp webhook URL.
API_PUBLIC_URL=https://api.example.com
# Signs unsubscribe links. Falls back to JWT_SECRET; set its own value so
# rotating the login secret does not break links in emails already sent.
COMMS_LINK_SECRET=
# Set to false on an instance that should not send queued messages.
COMMS_DISPATCHER=true

# Agentic Assistant
# Where staff reach the application, used for the link Composio sends people
# back to after they connect a mailbox.
APP_PUBLIC_URL=https://app.example.com
# Composio holds the OAuth tokens for connected mailboxes and other accounts,
# so no Google or Microsoft credential is ever stored here. Without this key,
# accounts simply cannot be connected; everything else works.
COMPOSIO_API_KEY=
# Verifies the webhooks Composio sends. An unsigned webhook is refused, so
# without this the assistant polls instead of being pushed to.
COMPOSIO_WEBHOOK_SECRET=
# Set to false on an instance that should serve requests but not run the
# assistant's background work (its queue, automations and expiring approvals).
ASSISTANT_WORKER=true
# How many assistant runs one instance works on at a time.
ASSISTANT_CONCURRENCY=2
# Allow MCP servers reached over plain http. Off; https only.
ASSISTANT_MCP_ALLOW_HTTP=false
