  @@unique([userId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@map("note_read_markers")
}

/// A message to or from a client: email, SMS or WhatsApp.
///
/// Outbound messages are written before they are sent and move through
/// QUEUED -> SENDING -> SENT -> DELIVERED (-> READ for WhatsApp), or end
/// FAILED or SKIPPED. A click-to-chat WhatsApp message ends OPENED: it was
/// handed to the staff member's WhatsApp, which the system cannot see beyond.
/// Inbound WhatsApp messages arrive RECEIVED, and may come from a number that
/// matches no client, hence the optional client.
model ClientMessage {
  id                String    @id @default(uuid())
  organizationId    String
  clientId          String?
  loanId            String?
  broadcastId       String?
  /// EMAIL | SMS | WHATSAPP
  channel           String
  /// SMTP | BULKSMS | WHATSAPP_CLOUD | CLICK_TO_CHAT
  provider          String
  /// OUTBOUND | INBOUND
  direction         String    @default("OUTBOUND")
  /// The email address or E.164 phone number.
  toAddress         String
  fromAddress       String?
  subject           String?
  body              String
  /// A WhatsApp template message: its name, language and parameters.
  templateName      String?
  templateLanguage  String?
  templateParams    Json?
  status            String    @default("QUEUED")
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime  @default(now())
  lockedAt          DateTime?
  sentById          String?
  queuedAt          DateTime  @default(now())
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client       Client?           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  loan         Loan?             @relation(fields: [loanId], references: [id], onDelete: SetNull)
  broadcast    MessageBroadcast? @relation(fields: [broadcastId], references: [id], onDelete: SetNull)
  sentBy       User?             @relation("ClientMessageSentBy", fields: [sentById], references: [id], onDelete: SetNull)

  @@index([organizationId, clientId, createdAt])
  @@index([organizationId, createdAt])
  @@index([loanId, createdAt])
  @@index([broadcastId, status])
  @@index([status, nextAttemptAt])
  @@index([provider, providerMessageId])
  @@map("client_messages")
}

/// One message sent to many clients at once.
model MessageBroadcast {
  id               String    @id @default(uuid())
  organizationId   String
  name             String
  channel          String
  subject          String?
  body             String
  templateName     String?
  templateLanguage String?
  templateParams   Json?
