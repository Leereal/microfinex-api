/// A message in the discussion thread on a client or a loan.
///
/// Deleting a message hides it rather than erasing it: the thread keeps its
/// shape ("message deleted") and the words stay on record for audit. Its
/// attachments are removed from storage, since a wrongly attached document is
/// the usual reason to delete.
model Note {
  id             String           @id @default(uuid())
  organizationId String
  entityType     NoteEntityType
  entityId       String
  content        String
  priority       NotePriority     @default(NORMAL)
  isPinned       Boolean          @default(false)
  isPrivate      Boolean          @default(false)
  createdBy      String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  /// When the author last changed the words - pinning is not an edit.
  editedAt       DateTime?
  deletedAt      DateTime?
  deletedBy      String?
  attachments    NoteAttachment[]
  creator        User             @relation(fields: [createdBy], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([createdBy])
  @@index([createdAt])
  @@map("notes")
}

/// How far one person has read one thread, for unread counts.
model NoteReadMarker {
  id             String         @id @default(uuid())
  organizationId String
  userId         String
  entityType     NoteEntityType
